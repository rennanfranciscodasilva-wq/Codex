rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function titular(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if titular(uid);

      match /{colecao}/{id} {
        function biblioteca() {
          return colecao == 'sistemas' || colecao == 'fichas' || colecao == 'rascunhos';
        }

        allow read: if titular(uid) && biblioteca();
      }

      match /controle/sincronizacao {
        allow read: if titular(uid);
      }
    }

    // Preserva a regra da coleção antiga de nível superior.
    match /fichas/{fichaId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.donoId;
    }
  }
}
